# Copy to .env.local for local development. Production values live in Vercel.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI providers (server-only) ---
OPENAI_API_KEY=
# Needs voices_read + voices_write (Voice Library narrators are added on demand).
ELEVENLABS_API_KEY=
# Voice Library narrators are only usable over the API on paid ElevenLabs
# plans. Auto-detected when the key has user_read; otherwise set "true" once
# the account is on Starter or above.
ELEVENLABS_LIBRARY_VOICES=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Launch lock (server-only) ---
# "false" closes content generation for everyone except BETA_USER_IDS
# (comma-separated auth.users ids). Rejected requests never charge credits.
GENERATION_ENABLED=false
BETA_USER_IDS=

# Who may open the admin panel (/admin). Comma-separated auth.users ids.
# While empty, BETA_USER_IDS is used instead.
ADMIN_USER_IDS=
# Extra admins by verified e-mail (comma-separated).
ADMIN_EMAILS=

# --- Kling AI video generation (server-only) ---
# Feature is OFF unless VIDEO_GENERATION_ENABLED=true. While off, the user ids in
# VIDEO_BETA_USER_IDS (comma-separated auth.users ids) may still use it for testing.
VIDEO_GENERATION_ENABLED=false
VIDEO_BETA_USER_IDS=
# New console keys (kling.ai/dev/api-key) are a single "api-key-kling-…" value:
KLING_API_KEY=
# Legacy Access/Secret pair (signed into a JWT) still works if KLING_API_KEY is unset:
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
# KLING_API_BASE=https://api-singapore.klingai.com

# --- Full video (one sentence → finished MP4) — private beta ---
# OFF unless FULL_VIDEO_ENABLED=true; FULL_VIDEO_BETA_USER_IDS is the allowlist.
# Needs the Kling keys above (hybrid/cinematic footage), GEMINI_API_KEY (stills)
# and a Shotstack account for the final render (shotstack.io → API keys).
# SHOTSTACK_ENV: "stage" = free sandbox with watermark, "v1" = production.
FULL_VIDEO_ENABLED=false
FULL_VIDEO_BETA_USER_IDS=
SHOTSTACK_API_KEY=
SHOTSTACK_ENV=stage

# --- fal.ai (server-only) — one key for many image/video models (Seedream,
# MiniMax H3, Wan…). Prepaid credits at fal.ai → Billing. Used by the model
# lab (/lab) and, once chosen, by the pipeline. Format: "key_id:key_secret".
FAL_KEY=
# Admin panel warns when the fal balance drops to 20% of this (USD; your usual top-up).
# FAL_TOPUP_USD=50

# --- Stock B-roll (server-only). Set ONE of these; Pexels wins when both are set.
# Pexels: pexels.com/api (key issuance may be paused). Pixabay: pixabay.com/api/docs
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Cloudflare R2 — finished MP4s (private bucket, no egress fees). Served from
# https://norveko.app/media/videos/r2/<key> (signed redirect). Unset = Supabase Storage.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=norveko-videos

# --- YouTube analytics (server-only) ---
# Old name NEXT_PUBLIC_YOUTUBE_API_KEY is still accepted but leaks the key to
# the browser; rename it to YOUTUBE_API_KEY in Vercel.
YOUTUBE_API_KEY=

# --- Cron / snapshot protection ---
CRON_SECRET=
SNAPSHOT_SECRET=

# --- Background pipeline worker ---
# Public URL the worker is reached at (used for self-chaining step runs).
NEXT_PUBLIC_SITE_URL=https://norveko.app
# Shared secret between /api/pipeline/start and /api/pipeline/run.
# Falls back to CRON_SECRET when unset.
PIPELINE_WORKER_SECRET=

# --- Sentry (error monitoring; optional) ---
# Create a Next.js project at sentry.io and paste its DSN. Without a DSN the
# SDK is fully disabled (no network calls, no overhead).
NEXT_PUBLIC_SENTRY_DSN=
# Source-map upload at build time (Vercel only). Create an auth token with the
# "project:releases" + "org:read" scopes.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# --- Provider cost log (lib/pipeline/usage.ts) ---
# Optional JSON to override list prices without a deploy, e.g.
# {"openai:gpt-5-mini":{"inputPer1M":0.25,"outputPer1M":2}}
PROVIDER_PRICE_OVERRIDES=

# --- Security headers ---
# Content-Security-Policy is enforced by default (next.config.ts). Set this
# to "true" to temporarily switch back to report-only mode if a third-party
# script (Paddle, Supabase) ever breaks after a release.
CSP_REPORT_ONLY=

# --- Paddle ---
# "sandbox" or "production". This single variable drives both client and server.
NEXT_PUBLIC_PADDLE_ENV=sandbox
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
# Price IDs for the three credit packages. Sandbox IDs are hardcoded as a
# fallback; production MUST set these to the live pri_... IDs.
NEXT_PUBLIC_PADDLE_PRICE_STARTER=
NEXT_PUBLIC_PADDLE_PRICE_PRO=
NEXT_PUBLIC_PADDLE_PRICE_BUSINESS=
# Subscription prices (recurring; sandbox fallbacks in lib/subscriptions.ts)
NEXT_PUBLIC_PADDLE_PRICE_CREATOR_WEEK=
NEXT_PUBLIC_PADDLE_PRICE_CREATOR_MONTH=
NEXT_PUBLIC_PADDLE_PRICE_CREATOR_YEAR=
NEXT_PUBLIC_PADDLE_PRICE_PRO_WEEK=
NEXT_PUBLIC_PADDLE_PRICE_PRO_MONTH=
NEXT_PUBLIC_PADDLE_PRICE_PRO_YEAR=
# Server-only
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=

# Public launch of full videos: set BOTH. The NEXT_PUBLIC_ one only switches the
# landing/billing copy (e.g. "one free 30-second video" in the free trial).
# FULL_VIDEO_ENABLED=true
# NEXT_PUBLIC_FULL_VIDEO_ENABLED=true

# --- YouTube publishing (direct upload, server-only) ---
# Google Cloud → APIs & Services → Credentials → OAuth client (Web application).
# Authorized redirect URI: https://norveko.app/api/youtube/callback
# Enable "YouTube Data API v3"; consent screen scopes youtube.upload + youtube.readonly.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Optional: encryption key for stored YouTube grants (defaults to PIPELINE_WORKER_SECRET).
# Never change it after users connected — existing grants would become unreadable.
YOUTUBE_TOKEN_KEY=

# --- TikTok posting (Content Posting API, server-only) ---
# developers.tiktok.com → app with Login Kit + Content Posting API (Direct Post),
# redirect URI https://norveko.app/api/tiktok/callback, scopes user.info.basic + video.publish.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# --- Heartbeat (Supabase pg_cron calls reap every minute + series tick hourly) ---
# Any long random string; the same value goes into the pg_cron SQL (supabase/README.md).
HEARTBEAT_SECRET=

# Instagram Reels publishing (Meta app → Instagram API with Instagram Login). Redirect URI: <site>/api/instagram/callback
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# --- Optional overrides (all have defaults in code; set only to change them) ---
# SCRIPT_MODEL=gpt-6.1-terra                 # script writer
# RESEARCH_MODEL=gpt-6.1-terra               # web research brief
# SCRIPT_JUDGE_MODEL=gpt-6.1-sol             # lab: script judge
# SKIT_BACKUP_MODEL=gemini-3.8-flash         # skit planner retry
# STOCK_VISION_MODEL=gemini-3.8-flash        # stock/archive frame check
# CHARACTER_CHECK_MODEL=gemini-3.8-flash     # character photo check
# GEMINI_TTS_MODEL=gemini-2.5-pro-preview-tts
# GEMINI_SCENE_IMAGE_MODEL=gemini-nano-banana-2.1
# FAL_VIDEO_MODEL=fal-ai/bytedance/seedance/v1.5/pro/image-to-video
# FAL_AVATAR_MODEL=fal-ai/kling-video/ai-avatar/v2/standard
# FAL_AVATAR_FALLBACK_MODEL=veed/fabric-1.0
# FAL_SWAP_MODEL=fal-ai/wan/v2.2-14b/animate/replace
# SERIES_LOOKAHEAD_HOURS=26                  # how far ahead series episodes are prepared
# WATERMARK_FORCE_USER_IDS=                  # test: treat these accounts as free-trial users
